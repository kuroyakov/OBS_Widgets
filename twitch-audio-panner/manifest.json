{
  "manifest_version": 3,
  "name": "MixConsole",
  "version": "1.3.2",
  "description": "開いているタブごとに定位(PAN)・音量・Arturia Pre 1973風ヴィンテージEQ/HPF・LUFSメーターを個別にミキシングできる拡張機能",
  "author": "Streamer",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
