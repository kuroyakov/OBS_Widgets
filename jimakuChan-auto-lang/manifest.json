{
  "manifest_version": 3,
  "name": "jimakuChan Auto Language Bridge (OBS_Widgets連携)",
  "version": "1.1.1",
  "description": "Twitch CommentViewerで検出された海外コメントの言語に合わせて、音声認識字幕ちゃん(v2/v1)の翻訳言語を自動切替（5分無発言で英語に自動復帰）し、Chrome内蔵翻訳をOBSへ中継します。",
  "permissions": [
    "storage"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://translate.googleapis.com/*",
    "https://sayonari.github.io/*",
    "https://www.sayonari.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://sayonari.github.io/jimakuChan/*",
        "https://www.sayonari.com/trans_asr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page_bridge.js"],
      "matches": [
        "https://sayonari.github.io/*",
        "https://www.sayonari.com/*"
      ]
    }
  ]
}
